################################  CONFIGURATION ################################
watch 5
learn --off
epmem --set learning off 
#smem --off
#log --level error






############### ALL INIT BUILD ###############

# Plan build: Se não existe plano, cria um plano com passo 0
sp {plan-build
   (state <s> ^io.output-link <OL>
             -^plan <P>)
-->
   (<OL> ^plan <P>)
   (<P> ^step 0)
}

# Action build
sp {world*propose*initialize
   (state <s> ^superstate nil
             -^name)
-->
   (<s> ^operator <o> + =)
   (<o> ^name initialize-world)
}

sp {world*apply*initialize
   (state <s> ^operator.name initialize-world)
-->

	(<s> ^action <act>)
	(<act> ^name wander)
   (<s> ^name World)
   (<s> ^gemCheck <gc>)
   (<gc> ^gemsNeeded 0)
   (<gc> ^gemsFound 0)
   (<s> ^bestLeafLet <bestLeafLet>)
   (<bestLeafLet> ^id 0 ^value 0.0)
   (write |WORLD INITIALIZED| (crlf))
   
}

sp {propose*change_best_leaflet
   (state <s> ^io.input-link <il>)
   (<il> ^CREATURE <creature>)
   (<creature> ^LEAFLETS <leaflets>)
   (<leaflets> ^LEAFLET <leaflet>)
   (<leaflet> ^ID <ID>)
   (<s> ^bestLeafLet <bestLeafLet>)
   (<bestLeafLet> ^id <bestID>)
   - (<s> ^bestLeafLetChosen)
   (<bestLeafLet> ^value <bestValue>)
   (<leaflet> ^PAYMENT <payment> > <bestValue>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name change_best_leaflet)
   (<o> ^id <ID>)
   (<o> ^value <payment>)
}

sp {apply*change_best_leaflet
   (state <s> ^operator <o>)
   (<o> ^name change_best_leaflet)
   (<o> ^id <ID>)
   (<o> ^value <payment>)
-->
   (<s> ^bestLeafLet <bestLeafLet> -)
   (<s> ^bestLeafLet <bestLeafLet>)
   (<bestLeafLet> ^id <ID>)
   (<bestLeafLet> ^value <payment>)
   (<s> ^bestLeafLetChosen 1)
}

############### GENERAL STATE ###############
# Propoe criar general_state quando bestLeafLet.id != 0 e nao existe ainda general_state
sp {propose*create_general_state
   (state <s> ^bestLeafLet <bestLeafLet>)
   (<bestLeafLet> ^id <bestID> <> 0)
   (state <s> -^general_state)
-->
   (<s> ^operator <o> + =)
   (<o> ^name create_general_state)
}

# Aplica a criacao do general_state
sp {apply*create_general_state
   (state <s> ^operator <o>)
   (<o> ^name create_general_state)
-->
   (<s> ^general_state <gs>)
   (<gs> ^status initialized)
}


############### WANDERING STATE ###############
# Verifica se deve sair do wandering:

# Se a acao é wander, continua a vagar
sp {propose*wandering
   (state <s> ^action <action>)
   (<action> ^name wander)
   (state <s> ^io.input-link <il>)
-->
   (<s> ^operator <o> + < )
   (<o> ^name wander)
}

# Apply*wander:
# If the wander operator is selected, then generate an output command to it 
sp {apply*wander
   (state <s> ^operator <o>
              ^io <io>)
   (<io> ^output-link <ol>)
   (<o> ^name wander)
-->
   (<ol> ^MOVE <command>)
   (<command> ^Vel 0)
   (<command> ^VelR 2)
   (<command> ^VelL 0)
   (interrupt) 
}

# Wander Preferences
sp {pref*wander
(state <s> ^operator <o> +)
(<o> ^name wander)
-->
(<s> ^operator <o> <)}
