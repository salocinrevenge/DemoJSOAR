################################  CONFIGURATION ################################
watch 5
learn --off
epmem --set learning off 
#smem --off
#log --level error






############### ALL INIT BUILD ###############

# Plan build: Se não existe plano, cria um plano com passo 0
sp {plan-build
   (state <s> ^io.output-link <OL>
             -^plan <P>)
-->
   (<OL> ^plan <P>)
   (<P> ^step 0)
}

# Action build
sp {world*propose*initialize
   (state <s> ^superstate nil
             -^name)
-->
   (<s> ^operator <o> + =)
   (<o> ^name initialize-world)
}

sp {world*apply*initialize
   (state <s> ^operator.name initialize-world)
-->

	(<s> ^action <act>)
	(<act> ^name wander)
   (<s> ^name World)
   (<s> ^gemCheck <gc>)
   (<gc> ^gemsNeeded 0)
   (<gc> ^gemsFound 0)
   (<s> ^bestLeafLet <bestLeafLet>)
   (<bestLeafLet> ^id 0 ^value 0.0)
   (write |WORLD INITIALIZED| (crlf))
   
}

sp {propose*change_best_leaflet
   (state <s> ^io.input-link <il>)
   (<il> ^CREATURE <creature>)
   (<creature> ^LEAFLETS <leaflets>)
   (<leaflets> ^LEAFLET <leaflet>)
   (<leaflet> ^ID <ID>)
   (<s> ^bestLeafLet <bestLeafLet>)
   (<bestLeafLet> ^id <bestID>)
   - (<s> ^bestLeafLetChosen)
   (<bestLeafLet> ^value <bestValue>)
   (<leaflet> ^PAYMENT <payment> > <bestValue>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name change_best_leaflet)
   (<o> ^id <ID>)
   (<o> ^value <payment>)
}

sp {apply*change_best_leaflet
   (state <s> ^operator <o>)
   (<o> ^name change_best_leaflet)
   (<o> ^id <ID>)
   (<o> ^value <payment>)
-->
   (<s> ^bestLeafLet <bestLeafLet> -)
   (<s> ^bestLeafLet <bestLeafLet>)
   (<bestLeafLet> ^id <ID>)
   (<bestLeafLet> ^value <payment>)
   (<s> ^bestLeafLetChosen 1)
}

############### GENERAL STATE ###############
# Propoe criar general_state quando bestLeafLet.id != 0 e nao existe ainda general_state
sp {propose*create_general_state
   (state <s> ^bestLeafLet <bestLeafLet>)
   (<bestLeafLet> ^id <bestID> <> 0)
   (state <s> -^general_state)
-->
   (<s> ^operator <o> + =)
   (<o> ^name create_general_state)
}

# Aplica a criacao do general_state - Copia profunda do input-link e cria sacoNeg
sp {apply*create_general_state
   (state <s> ^operator <o>
              ^io <io>
              ^bestLeafLet <bestLeafLet>)
   (<io> ^input-link <il>)
   (<il> ^CREATURE <creature>)
   (<creature> ^SENSOR <sensor>)
   (<sensor> ^FUEL <fuel>)
   (<fuel> ^VALUE <fuelValue>)
   (<sensor> ^VISUAL <visual>)
   (<creature> ^LEAFLETS <leaflets>)
   (<leaflets> ^LEAFLET <leaflet>)
   (<leaflet> ^ID <bestID>)
   (<bestLeafLet> ^id <bestID>)
   (<o> ^name create_general_state)
-->
   # Criar estrutura geral_state com raiz
   (<s> ^general_state <gs>)
   (<gs> ^status initialized)
   
   # Copiar combustível (cópia profunda do FUEL)
   (<gs> ^fuel <fuelCopy>)
   (<fuelCopy> ^value <fuelValue>)
   
   # Copiar estrutura de visão (SENSOR.VISUAL)
   (<gs> ^visual <visualCopy>)
   (<visualCopy> ^entity-list <entityList>)
   
   # Criar sacoNeg com base no leaflet necessário
   (<gs> ^sacoNeg <sacoNeg>)
   (<sacoNeg> ^leaflet-id <bestID>)
   (<sacoNeg> ^total-missing -1)
   (write |GENERAL STATE CREATED - Fuel: | <fuelValue> | for leaflet: | <bestID> (crlf))
}

# Copiar todas as entidades visuais para general_state (comidas e jóias)
sp {apply*create_general_state*copy*entities
   (state <s> ^general_state <gs>)
   (<gs> ^visual <visualCopy>)
   (<visualCopy> ^entity-list <entityList>)
   (state <s> ^io.input-link <il>)
   (<il> ^CREATURE <creature>)
   (<creature> ^SENSOR.VISUAL <visual>)
   (<visual> ^ENTITY <entity>)
   (<entity> ^TYPE <type>)
   (<entity> ^NAME <name>)
   (<entity> ^DISTANCE <distance>)
   (<entity> ^X <x>)
   (<entity> ^Y <y>)
-->
   # Copiar cada entidade (cópia profunda)
   (<entityList> ^entity <entityCopy>)
   (<entityCopy> ^type <type>)
   (<entityCopy> ^name <name>)
   (<entityCopy> ^distance <distance>)
   (<entityCopy> ^x <x>)
   (<entityCopy> ^y <y>)
   # (write |COPIED ENTITY - Type: | <type> | Name: | <name> | Distance: | <distance> | X: | <x> | Y: | <y> (crlf))
}

# Copiar informações de cor das entidades (se houver)
sp {apply*create_general_state*copy*entity*color
   (state <s> ^general_state <gs>)
   (<gs> ^visual <visualCopy>)
   (<visualCopy> ^entity-list <entityList>)
   (state <s> ^io.input-link <il>)
   (<il> ^CREATURE <creature>)
   (<creature> ^SENSOR.VISUAL.ENTITY <entity>)
   (<entity> ^TYPE <type>)
   (<entity> ^NAME <name>)
   (<entity> ^COLOR <color>)
   (<entityList> ^entity <entityCopy>)
   (<entityCopy> ^name <name>)
-->
   (<entityCopy> ^color <color>)
   # (write |COPIED ENTITY COLOR - Type: | <type> | Name: | <name> | Color: | <color> (crlf))

}

# Criar sacoNeg com as cores necessárias do leaflet escolhido
sp {apply*create_general_state*create*sacoNeg
   (state <s> ^general_state <gs>)
   (<gs> ^sacoNeg <sacoNeg>)
   (<gs> ^status initialized)
   (state <s> ^bestLeafLet <bestLeafLet>)
   (<bestLeafLet> ^id <bestID>)
   (state <s> ^io.input-link <il>)
   (<il> ^CREATURE <creature>)
   (<creature> ^LEAFLETS <leaflets>)
   (<leaflets> ^LEAFLET <leaflet>)
   (<leaflet> ^ID <bestID>)
   (<leaflet> ^MISSING <totalMissing>)
-->
   # Remover total-missing antigo
   (<sacoNeg> ^total-missing -1 -)
   # Armazenar total de jóias faltantes
   (<sacoNeg> ^total-missing <totalMissing>)
   (write |GENERAL STATE CREATED - Total missing items: | <totalMissing> | for leaflet: | <bestID> (crlf))
}

# Copiar as cores faltantes do leaflet para o sacoNeg
sp {apply*create_general_state*create*sacoNeg*colors
   (state <s> ^general_state <gs>)
   (<gs> ^sacoNeg <sacoNeg>)
   (<gs> ^status initialized)
   (<sacoNeg> ^leaflet-id <bestID>)
   (state <s> ^io.input-link <il>)
   (<il> ^CREATURE <creature>)
   (<creature> ^LEAFLETS <leaflets>)
   (<leaflets> ^LEAFLET <leaflet>)
   (<leaflet> ^ID <bestID>)
   (<leaflet> ^MISSING_COLOR <missingColor>)
   (<missingColor> ^COLOR <color>)
   (<missingColor> ^COUNT <count>)
-->
   # Copiar cada cor faltante para o sacoNeg
   (<sacoNeg> ^missing-color <missingColorCopy>)
   (<missingColorCopy> ^color <color>)
   (<missingColorCopy> ^count <count>)
   (<missingColorCopy> ^visible-count 0)
   # (write |COPIED MISSING COLOR - Color: | <color> | Count: | <count> | for leaflet: | <bestID> (crlf))
}

# 1. Proposição
sp {propose*count-jewel
   (state <s> ^general_state <gs>)
   (<gs> ^visual.entity-list.entity <e>)
   (<e> ^type JEWEL ^color <color>)
   (<gs> ^sacoNeg.missing-color <mc>)
   (<mc> ^color <color>)
   - (<e> ^counted-for <mc>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name count-jewel
        ^entity <e>
        ^target-color-ref <mc>
        ^color-name <color>) # Adicionei isso para facilitar o log
}

# 2. Aplicação
sp {apply*count-jewel
   (state <s> ^operator <o>)
   (<o> ^name count-jewel
        ^entity <e>
        ^target-color-ref <mc>
        ^color-name <color>)
   (<mc> ^visible-count <current>) # Aqui é onde costuma falhar se o valor sumir
-->
   (<mc> ^visible-count <current> -
                  (+ <current> 1))
   (<e> ^counted-for <mc>)
   (write |COUNTED JEWEL | <color> | - New count: | (+ <current> 1) (crlf))
}

# 1. Propor o planejamento (Apenas testa condições)
sp {propose*start-planning
   (state <s> ^general_state <gs>)
   (state <s> -^planning-started) # Se já planejou, não propõe mais
   - (<s> ^operator.name count-jewel) 
   (<gs> ^sacoNeg <sacoNeg>)
   # Garante que todas as cores necessárias têm count visível suficiente
   - {
      (<sacoNeg> ^missing-color <mc>)
      (<mc> ^count <required>)
      (<mc> ^visible-count < <required>)
   }
-->
   (<s> ^operator <o> + =)
   (<o> ^name start-planning)
}

# 2. Aplicar o planejamento (Efetua a mudança no estado)
sp {apply*start-planning
   (state <s> ^operator <o>)
   (<o> ^name start-planning)
-->
   (<s> ^planning-started 1)
   (write |ALL REQUIRED JEWELS VISIBLE - STARTING PLANNING| (crlf))
}

sp {pref*count-over-planning
   (state <s> ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name count-jewel)
   (<o2> ^name start-planning)
-->
   (<s> ^operator <o1> > <o2>)
}


################## PLANNING STATE ###############
# Proposição do operador plan-move-jewel
# Propõe mover para uma joia quando ainda há jóias faltantes
sp {propose*plan-move-jewel
   (state <s> ^general_state <gs>)
   (<gs> ^sacoNeg <sacoNeg>)
   (<sacoNeg> ^total-missing <totalMissing> > 0)
   # Encontra uma cor que ainda tem jóias para coletar
   (<sacoNeg> ^missing-color <mc>)
   (<mc> ^color <color>)
   (<mc> ^count <count> > 0)
   # Encontra uma entidade visual com essa cor
   (<gs> ^visual.entity-list.entity <entity>)
   (<entity> ^type JEWEL)
   (<entity> ^color <color>)
   (<entity> ^x <x>)
   (<entity> ^y <y>)
   (<entity> ^name <entityName>)
   # Obtém o step atual do plano
   (state <s> ^io.output-link.plan <plan>)
   (<plan> ^step <currentStep>)
   (<s> ^planning-started 1)
-->
   (<s> ^operator <o> + =)
   (<o> ^name plan-move-jewel)
   (<o> ^target-color <color>)
   (<o> ^target-coordinate <coord>)
   (<coord> ^x <x>)
   (<coord> ^y <y>)
   (<o> ^target-entity <entity>)
   (<o> ^target-entity-name <entityName>)
   (<o> ^missing-color-ref <mc>)
   (<o> ^current-step <currentStep>)
   # (write |PROPOSED: Plan move jewel to | <color> | at (| <x> |, | <y> |)| (crlf))
}

# Aplicação do operador plan-move-jewel
# Adiciona o movimento ao plano (em uma estrutura de vetor) e incrementa o step
sp {apply*plan-move-jewel
   (state <s> ^operator <o>
              ^general_state <gs>
              ^io.output-link.plan <plan>)
   (<o> ^name plan-move-jewel)
   (<o> ^target-coordinate <coord>)
   (<coord> ^x <x> ^y <y>)
   (<o> ^target-entity <entity>)
   (<o> ^target-entity-name <entityName>)
   (<o> ^missing-color-ref <mc>)
   (<o> ^current-step <currentStep>)
   (<gs> ^sacoNeg <sacoNeg>)
   (<plan> ^step <currentStep>) # O step atual deve bater com o do operador
   (<sacoNeg> ^total-missing <totalMissing>)
   (<mc> ^count <count>)
   (<mc> ^visible-count <visibleCount>)
-->
   # 1. Adiciona o MOVE no step atual
   (<plan> ^<currentStep> <stepAction>)
   (<stepAction> ^MOVE <command>)
   (<command> ^Vel 1 ^VelR 1 ^VelL 1 ^X <x> ^Y <y>)
   
   # 2. Adiciona o GET no próximo step (current + 1)
   (<plan> ^(+ <currentStep> 1) <getAction>)
   (<getAction> ^GET <getCommand>)
   (<getCommand> ^Name <entityName>)

   # 3. Atualiza o ponteiro do step para dali a 2 posições
   (<plan> ^step <currentStep> -
           ^step (+ <currentStep> 2))

   # 4. Atualiza o Saco Negativo e remove a entidade "planejada"
   (<gs> ^visual.entity-list <el>)
   (<el> ^entity <entity> -)
   (<mc> ^count <count> -
         ^count (- <count> 1))
   (<mc> ^visible-count <visibleCount> -
         ^visible-count (- <visibleCount> 1))
   (<sacoNeg> ^total-missing <totalMissing> -
              ^total-missing (- <totalMissing> 1))

   (write |APPLIED: Planned MOVE and GET for | <entityName> | - New Step: | (+ <currentStep> 2) (crlf))
}

# Preferência entre operadores plan-move-jewel
# Escolhe qualquer caso de joia válida (sem preferência específica)
sp {pref*plan-move-jewel
   (state <s> ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name plan-move-jewel)
   (<o2> ^name plan-move-jewel)
-->
   # Ambos são igualmente bons - deixa o Soar decidir
}

# Preferência: planejamento tem prioridade sobre contar joias
sp {pref*plan-move-over-count
   (state <s> ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name plan-move-jewel)
   (<o2> ^name count-jewel)
-->
   (<s> ^operator <o1> > <o2>)
}

# Preferência: planejamento tem prioridade sobre start-planning
sp {pref*plan-move-over-start-planning
   (state <s> ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name plan-move-jewel)
   (<o2> ^name start-planning)
-->
   (<s> ^operator <o1> > <o2>)
}

# Preferência: planejamento tem prioridade sobre wandering
sp {pref*plan-move-over-wander
   (state <s> ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name plan-move-jewel)
   (<o2> ^name wander)
-->
   (<s> ^operator <o1> > <o2>)
}


################## DELIVERY STATE ###############
# Proposição do operador plan-move-delivery-spot
# Propõe mover para o ponto de entrega quando todos os itens foram coletados
sp {propose*plan-move-delivery-spot
   (state <s> ^general_state <gs>)
   (<gs> ^sacoNeg <sacoNeg>)
   (<sacoNeg> ^total-missing <= 0) # MUDANÇA AQUI: Sintaxe correta Soar
   (<gs> ^visual.entity-list.entity <entity>)
   (<entity> ^type DELIVERYSPOT ^x <x> ^y <y> ^name <entityName>)
   (state <s> ^io.output-link.plan <plan>)
   (<plan> ^step <currentStep>)
   (<s> ^planning-started 1)
-->
   (<s> ^operator <o> + =)
   (<o> ^name plan-move-delivery-spot
        ^target-coordinate <coord>
        ^target-entity <entity>
        ^target-entity-name <entityName>
        ^current-step <currentStep>)
   (<coord> ^x <x> ^y <y>)
   (write |PROPOSED: All items collected. Planning move to delivery spot.| (crlf))
}

# Aplicação do operador plan-move-delivery-spot
# Adiciona o movimento para o delivery spot ao plano
sp {apply*plan-move-delivery-spot
   (state <s> ^operator <o>
              ^general_state <gs>
              ^io <io>)
   (<io> ^output-link <ol>)
   (<ol> ^plan <plan>)
   (<o> ^name plan-move-delivery-spot)
   (<o> ^target-coordinate <coord>)
   (<coord> ^x <x>)
   (<coord> ^y <y>)
   (<o> ^current-step <currentStep>)
   (<plan> ^step <currentStep>)
-->
   # Criar elemento no plan para este step com o MOVE
   (<plan> ^<currentStep> <stepAction>)
   (<stepAction> ^MOVE <command>)
   (<command> ^Vel 1)
   (<command> ^VelR 1)
   (<command> ^VelL 1)
   (<command> ^X <x>)
   (<command> ^Y <y>)
   
   # Incrementar o step do plan
   (<plan> ^step <currentStep> -
                (+ <currentStep> 1))
   
   (write |APPLIED: Planned move to delivery spot at (| <x> |, | <y> |) - Step: | <currentStep> (crlf))
}

# Proposição do operador plan-deliver-leaflet
# Propõe entregar o folheto quando está próximo do ponto de entrega
sp {propose*plan-deliver-leaflet
   (state <s> ^general_state <gs>)
   (<gs> ^sacoNeg <sacoNeg>)
   (<sacoNeg> ^total-missing <= 0) # MUDANÇA AQUI
   (<gs> ^visual.entity-list.entity <entity>)
   (<entity> ^type DELIVERYSPOT ^distance < 30)
   (state <s> ^io.input-link.CREATURE.LEAFLETS.LEAFLET <leaflet>)
   (<leaflet> ^ID <leafletId> ^SCORE <score>)
   (<sacoNeg> ^leaflet-id <leafletId>)
   (state <s> ^io.output-link.plan <plan>)
   (<plan> ^step <currentStep>)
-->
   (<s> ^operator <o> + =)
   (<o> ^name plan-deliver-leaflet
        ^leaflet-id <leafletId>
        ^leaflet-score <score>
        ^current-step <currentStep>)
}

# Aplicação do operador plan-deliver-leaflet
# Adiciona a entrega do folheto ao plano, executa o primeiro comando e reseta o estado
sp {apply*plan-deliver-leaflet
   (state <s> ^operator <o>
              ^general_state <gs>
              ^io <io>
              ^action <act>)
   (<io> ^output-link <ol>)
   (<ol> ^plan <plan>)
   (<plan> ^0 <firstCommand>)
   (<o> ^name plan-deliver-leaflet)
   (<o> ^leaflet-id <leafletId>)
   (<o> ^leaflet-score <score>)
   (<o> ^current-step <currentStep>)
   (<plan> ^step <currentStep>)
-->
   # Criar elemento no plan para este step com o DELIVER
   (<plan> ^<currentStep> <stepAction>)
   (<stepAction> ^DELIVER <command>)
   (<command> ^ID <leafletId>)
   
   # Incrementar o step do plan
   (<plan> ^step <currentStep> -
                (+ <currentStep> 1))
   
   # Copiar o primeiro comando do plano para o output-link e executar
   (<ol> ^MOVE <firstCommand>)
   
   # Remover planning-started
   (<s> ^planning-started 1 -)
   
   # Remover general_state
   (<s> ^general_state <gs> -)
   
   # Resetar action para wander
   (<s> ^action <act> -)
   (<s> ^action <newAct>)
   (<newAct> ^name wander)
   
   (write |APPLIED: Planned deliver leaflet ID: | <leafletId> | - Step: | <currentStep> (crlf))
   (write |EXECUTION STARTED - First command being executed| (crlf))
}

# Preferências para as operações de entrega
# Move delivery spot tem prioridade sobre contar/planejar joias
sp {pref*plan-move-delivery-over-plan-move-jewel
   (state <s> ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name plan-move-delivery-spot)
   (<o2> ^name plan-move-jewel)
-->
   (<s> ^operator <o1> > <o2>)
}

# Deliver leaflet tem prioridade máxima
sp {pref*plan-deliver-over-all
   (state <s> ^operator <o1> +
              ^operator <o2> +)
   (<o1> ^name plan-deliver-leaflet)
   (<o2> ^name << plan-move-delivery-spot plan-move-jewel count-jewel start-planning >>)
-->
   (<s> ^operator <o1> > <o2>)
}


############### WANDERING STATE ###############
# Verifica se deve sair do wandering:

# Se a acao é wander, continua a vagar
sp {propose*wandering
   (state <s> ^action <action>)
   (<action> ^name wander)
   (state <s> ^io.input-link <il>)
-->
   (<s> ^operator <o> + < )
   (<o> ^name wander)
}

# Apply*wander:
# If the wander operator is selected, then generate an output command to it 
sp {apply*wander
   (state <s> ^operator <o>
              ^io <io>)
   (<io> ^output-link <ol>)
   (<o> ^name wander)
-->
   (<ol> ^MOVE <command>)
   (<command> ^Vel 0)
   (<command> ^VelR 2)
   (<command> ^VelL 0)
   (interrupt) 
}

# Wander Preferences
sp {pref*wander
(state <s> ^operator <o> +)
(<o> ^name wander)
-->
(<s> ^operator <o> <)}
